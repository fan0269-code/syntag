# Copy to an untracked .env for local development.
# Set production values in the Vercel project. Never commit real credentials.

# Pooled Postgres URL for the Next.js runtime (serverless).
# Use the pooled string from Neon, Vercel Postgres, or another hosted Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.example:5432/DATABASE?sslmode=require"

# Direct Postgres URL for prisma migrate deploy. Required when DATABASE_URL
# points at PgBouncer or a Neon pooler. Prisma CLI reads this first.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.example:5432/DATABASE?sslmode=require"

# Public origin. Application canonicals are fixed to this value in src/lib/seo.ts.
# Set the same value in Vercel Production. Do not point it at a preview URL.
NEXT_PUBLIC_SITE_URL="https://syrtag.com"

# Optional. Set to 1 only on the Vercel Production environment after the
# database exists, if migrate deploy should run during the Vercel build.
# Leave unset for Preview. This never seeds and never resets the database.
# PRISMA_MIGRATE_ON_BUILD=1
